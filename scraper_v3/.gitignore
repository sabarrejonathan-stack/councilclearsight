# the repository.
data/cache.sqlite
data/cache.sqlite-journal
data/cache.sqlite-wal
data/cache.sqlite-shm
data/scraper.jsonl
data/stage1.jsonl
data/stage2.jsonl
data/stage3.jsonl
data/stage4.jsonl

# Detection results are smaller (~30MB) — gitignored by default but you can
# remove this line if you want them committed.
data/detections/

# Pyc / venv / IDE
__pycache__/
*.pyc
.venv/
.pytest_cache/
