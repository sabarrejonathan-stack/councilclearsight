garding%20the%20Public%20Realm%20Weed%20Treatment%20Programme.%20There%20was%20extensive%20discussion%20with%20a%20wide%20range%20of%20views%20expressed%20on%20the%20use%20of%20glyphosate.%20While%20some%20supported%20chemical%20use%20and%20others%20opposed%20it%2C%20there%20was%20broad%20concern%20across%20the%20chamber%20about%20the%20process%20followed%2C%20along%20with%20acknowledgements%20and%20apologies%20regarding%20how%20parish%20and%20town%20councils%20have%20been%20treated.%F0%9F%93%8C%20Cornwall%20Council%20resolutions%3A%E2%9C%94%EF%B8%8F%20Policy%20recognition%20-%20The%20Council%20recognised%20that%20the%20decision%20to%20reintroduce%20chemical%20weed%20treatment%20using%20glyphosate%20represents%20a%20significant%20policy%20reversal%20with%20important%20ecological%2C%20public%20health%2C%20and%20democratic%20implications%20for%20communities%20across%20Cornwall.%E2%8F%B8%EF%B8%8F%20Pause%20on%20rollout%20-%20The%20planned%20commencement%20of%20chemical%20weed%20treatment%20%28scheduled%20for%20May%202026%29%20will%20be%20paused%20until%20a%20meaningful%20public%20consultation%20has%20taken%20place.%F0%9F%93%A3%20Public%20consultation%20%26amp%3B%20opt-out%20extension%20-%20The%20Council%20acknowledged%20that%20the%20three-week%20opt-out%20window%20for%20parish%20and%20town%20councils%20was%20inadequate%20%28and%20included%20the%20Easter%20period%29.%20This%20will%20now%20be%20extended%20to%20%2A%2A30%20days%20following%20publication%20of%20the%20consultation%20results%2A%2A.%F0%9F%93%98%20Clearer%20guidance%20-%20Clearer%20guidance%20will%20be%20provided%20to%20town%20and%20parish%20councils%20on%20the%20minimum%20required%20standards%20of%20the%20urban%20network.%F0%9F%92%B7%20Review%20of%20financial%20terms%20-%20An%20urgent%20review%20will%20be%20undertaken%20of%20the%20financial%20terms%20of%20the%20opt-out%20scheme.%20As%20currently%20structured%3ACouncils%20opting%20out%20of%20glyphosate%20treatment%20would%20lose%20associated%20estate%20improvement%20works.%20They%20would%20only%20receive%20funding%20equivalent%20to%20chemical%20treatment%20costs%20%28%C2%A3343.45%20per%20km%29.%20Additional%20costs%20%28alternative%20weed%20management%2C%20waste%20clearance%2C%20liability%20insurance%29%20would%20fall%20locallyThe%20Council%20has%20committed%20to%20reviewing%20and%20decoupling%20this%20arrangement.%F0%9F%8C%B1%20Further%20updates%20will%20follow%20as%20the%20consultation%20process%20progresses.%09%09%09%09"},"expenditure_over_100":{"found":false,"url":""},"asset_register":{"found":false,"url":""},"councillor_responsibilities":{"found":false,"url":""},"data_completeness_pct":34.5,"indicators_evidence_found_count":10,"social_facebook_url":"https://facebook.com/1396718790639428","social_twitter_url":"https://twitter.com/intent/tweet?text=https%3A%2F%2Fwww.facebook.com%2F1396718790639428%2Fposts%2F970649445361584"},"scrape_status":"ok"}